{
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.7.2",
      "config": {
        "includeFiles": "includes/**/*.php,pages/**/*.php"
      }
    }
  ],
  "routes": [
    {
      "src": "/images/(.*)",
      "dest": "/public/images/$1"
    },
    {
      "src": "/(.+\\.(?:png|jpg|jpeg|gif|webp|svg|ico|css|js|woff|woff2|ttf|json))",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "framework": null
}
